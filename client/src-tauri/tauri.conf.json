{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Reality Client",
  "version": "0.1.0",
  "identifier": "com.sky.realityclient",
  "build": {
    "beforeDevCommand": "npm run prepare:xray && npm run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run prepare:xray && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Reality Client",
        "width": 760,
        "height": 560,
        "minWidth": 620,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [],
    "externalBin": ["binaries/xray"]
  }
}
