{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Private Network Connect",
  "version": "0.1.0",
  "identifier": "com.sky.realityclient",
  "build": {
    "beforeDevCommand": "npm run prepare:xray && npm run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run prepare:xray && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Private Network Connect",
        "width": 880,
        "height": 650,
        "minWidth": 680,
        "minHeight": 540
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Private network access for invited members.",
    "longDescription": "Connects an invited member device to assigned private network nodes.",
    "icon": ["icons/icon.png", "icons/icon.icns", "icons/icon.ico"],
    "externalBin": ["binaries/xray"]
  }
}
