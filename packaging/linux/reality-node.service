[Unit]
Description=Private Network Node Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=reality-node
Group=reality-node
ExecStart=/opt/private-network-node/current/node-host run --data-dir /var/lib/private-network-node
Restart=on-failure
RestartSec=10s
StartLimitIntervalSec=300
StartLimitBurst=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
ReadWritePaths=/var/lib/private-network-node /var/log/private-network-node
StateDirectory=private-network-node
LogsDirectory=private-network-node
UMask=0077

[Install]
WantedBy=multi-user.target
