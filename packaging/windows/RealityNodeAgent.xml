<service>
  <id>RealityNodeAgent</id>
  <name>Private Network Node Agent</name>
  <description>Maintains the approved Private Network node runtime.</description>
  <executable>%BASE%\current\node-host.exe</executable>
  <arguments>run --data-dir &quot;%ProgramData%\Private Network Node\state&quot;</arguments>
  <logpath>%ProgramData%\Private Network Node\logs</logpath>
  <log mode="roll-by-size">
    <sizeThreshold>10485760</sizeThreshold>
    <keepFiles>4</keepFiles>
  </log>
  <onfailure action="restart" delay="10 sec" />
  <onfailure action="restart" delay="30 sec" />
  <resetfailure>1 hour</resetfailure>
  <stoptimeout>30 sec</stoptimeout>
  <serviceaccount>
    <username>NT AUTHORITY\LocalService</username>
    <allowservicelogon>true</allowservicelogon>
  </serviceaccount>
</service>
