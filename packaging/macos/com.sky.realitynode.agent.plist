<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.sky.realitynode.agent</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Library/Application Support/Private Network Node/bin/reality-node-service</string>
  </array>
  <key>UserName</key>
  <string>_privnetnode</string>
  <key>GroupName</key>
  <string>_privnetnode</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ProcessType</key>
  <string>Background</string>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>/Library/Logs/Private Network Node/agent.log</string>
  <key>StandardErrorPath</key>
  <string>/Library/Logs/Private Network Node/agent.error.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>RUST_LOG</key>
    <string>node_host=info</string>
  </dict>
</dict>
</plist>
